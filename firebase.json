{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/.*/**",
      "**/node_modules/**",
      "design-reference/**",
      "assets/images/background-for-hero.jpg",
      "package.json",
      "package-lock.json",
      "scripts/**",
      "forms/**",
      "prompts/**"
    ],
    "redirects": [
      {
        "source": "/neuromodulation-interest-prerna-shah/",
        "destination": "/neuromodulation-interest-prerna-shah",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/neuromodulation-interest-prerna-shah",
        "destination": "/neuromodulation-interest-prerna-shah.html"
      },
      {
        "source": "/refund-policy",
        "destination": "/refund-policy.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/!(*.@(css|js|jpg|jpeg|png|webp|gif|svg|ico|woff|woff2|glb|usdz|json|xml|txt))",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|woff|woff2|glb|usdz)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
